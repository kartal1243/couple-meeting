{
  "appId": "com.couplemeeting.app",
  "appName": "Couple Meeting",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "allowNavigation": [
      "couplemeeting.com.tr",
      "couplemeeting.comtr"
    ]
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#7c3aed",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": true,
      "spinnerColor": "#ffffff"
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#7c3aed"
    }
  }
}
